  "notes": {
   "/^复合体 I$/": [
    "复合体 I",
    "NADH 脱氢酶：泵 4 H⁺",
    "约 45 个亚基、近 1 MDa，L 形：伸进基质的外周臂（NADH 结合位点 FMN 和 8 个铁硫簇）+ 埋在膜里的膜臂（3 个类反向转运体亚基 ND2/ND4/ND5 等，质子通道）。每氧化 1 个 NADH 泵出 4 个 H⁺。"
   ],
   "/^复合体 III$/": [
    "复合体 III（二聚体）",
    "细胞色素 bc1：Q 循环",
    "同二聚体。每个单体有细胞色素 b（血红素 bL、bH）、细胞色素 c1 和 Rieske 铁硫蛋白；Rieske 的头部在 Qo 位点和 c1 之间摆动传电子。"
   ],
   "/^复合体 IV$/": [
    "复合体 IV",
    "细胞色素 c 氧化酶：O₂ → H₂O",
    "电子从细胞色素 c 进入 CuA（双铜中心），经血红素 a 到 a3–CuB 双核中心还原 O₂。每 4 个电子还原 1 个 O₂ 成 2 个 H₂O，同时泵出 4 个 H⁺。"
   ],
   "细胞色素 c": [
    "细胞色素 c",
    "膜间隙里的电子穿梭体",
    "约 104 个残基的小蛋白，共价连着一个血红素 c；在复合体 III 和 IV 之间一次运 1 个电子。它从线粒体释放到胞质也是细胞凋亡的信号。"
   ],
   "subunit C1": [
    "c 环（c8）",
    "ATP 合酶膜内转子",
    "H⁺ 经 a 亚基半通道结合、离开 c 亚基的 Glu58，推动 c 环转动；8 个 H⁺ 转一圈。"
   ],
   "subunit beta": [
    "β 亚基 ×3",
    "ATP 合酶催化位点",
    "γ 转动依次改变三个 β 的构象（开放 / 松弛 / 紧密），每转一圈合成 3 个 ATP。"
   ],
   "subunit gamma": [
    "γ 亚基",
    "ATP 合酶中心柄",
    "与 c 环一起转动，偏心轴驱动 β 构象变化。"
   ]
