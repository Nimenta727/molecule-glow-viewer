  "notes": {
   "定子": [
    "定子 MotA/MotB ×11",
    "利用 H⁺ 流产生力矩",
    "每个定子是 MotA5B2 复合物，MotB 锚定在细胞壁（肽聚糖）上。H⁺ 经 MotA/MotB 通道流入细胞，使 MotA 五聚体转动，像齿轮一样拨动 C 环。（本模型的定子结构 6YKM 来自空肠弯曲菌，转子部分来自沙门氏菌，为拼接示意。）"
   ],
   "C 环": [
    "C 环（FliG/FliM/FliN）",
    "转子 + 换向开关",
    "位于胞质侧的大环。FliG 与定子接触接受力矩；CheY-P 结合 FliM 后 C 环构象改变，使电机由逆时针（前进）切换为顺时针（翻滚）。"
   ],
   "M-ring": [
    "MS 环",
    "膜内转子基座",
    "FliF 组成的环嵌在内膜中，与 C 环相连，一起转动。"
   ],
   "MS ring": [
    "MS 环",
    "膜内转子基座",
    "FliF 组成的环嵌在内膜中，与 C 环相连，一起转动。"
   ],
   "L-ring": [
    "L 环",
    "外膜轴承",
    "嵌在外膜（LPS 层）中，像轴承一样让杆在其中转动。"
   ],
   "P-ring": [
    "P 环",
    "肽聚糖层轴承",
    "位于细胞壁肽聚糖层，与 L 环一起组成轴承。"
   ],
   "rod": [
    "杆",
    "传动轴",
    "把转子的转动穿过细胞壁传到外面的钩。"
   ],
   "hook protein": [
    "钩",
    "柔性万向节",
    "弯曲的短管，把转动传给鞭毛丝，同时允许方向改变。"
   ],
   "鞭毛丝": [
    "鞭毛丝",
    "螺旋桨",
    "由上万个鞭毛蛋白组装成的长螺旋管，转动时推动细菌前进。"
   ],
   "FliP": [
    "输出装置",
    "组装鞭毛的输出通道",
    "FliP/FliQ/FliR 组成输出门，把鞭毛蛋白从中央通道送到顶端组装。动画里它随转子一起转，但输出门是否随转子转动在文献中尚有争议。"
   ]
  }
 }
