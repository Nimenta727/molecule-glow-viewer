{
  "name": "glow-studio",
  "productName": "分子光影",
  "version": "0.3.2",
  "description": "分子光影查看器桌面版：离线缓存结构，后续接入创意工坊",
  "license": "Apache-2.0",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync.js",
    "start": "node scripts/sync.js && electron .",
    "dist": "node scripts/sync.js && electron-builder --win portable"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.nimenta727.glowstudio",
    "productName": "分子光影",
    "artifactName": "GlowStudio-${version}-portable.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "vendor/**",
      "LICENSE",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "electronDist": "node_modules/electron/dist",
    "executableName": "GlowStudio"
  },
  "author": "molecule-glow-viewer contributors"
}
