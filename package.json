{
  "name": "molecule-glow-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "A single-file Three.js molecular viewer with an optional Electron desktop build.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/desktop-config.test.cjs",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "repository": "https://github.com/Nimenta727/molecule-glow-viewer",
  "devDependencies": {
    "electron": "42.11.16",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.nimenta727.moleculeglowviewer",
    "productName": "Molecule Glow Viewer",
    "files": [
      "index.html",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
