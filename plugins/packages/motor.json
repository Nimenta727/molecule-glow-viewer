{
  "format": "glow-plugin",
  "schemaVersion": 1,
  "id": "org.glow.plugin.motor",
  "version": "1.0.0",
  "name": "沿轨道行走的马达",
  "summary": "ATP 驱动的单头马达沿轨道一步一步走：ATP 浓度与负载力可调，数前进/后退步数与速度。",
  "category": "process",
  "adds": [
    "三态循环（空 / ATP 结合 / ADP 结合）加位置计数，含后退",
    "负载力按单势垒模型减慢前进、加快后退",
    "速度随 ATP 浓度饱和、随负载下降"
  ],
  "usage": [
    {
      "title": "把马达加进作品",
      "how": "在 Studio 的“工具”页签选“沿轨道行走的马达”预设；调 ATP 浓度与负载力看平均速度"
    },
    {
      "title": "代码里取现成的配置",
      "how": "import { PROCESS_PRESETS } from 'plugins/simulation/process-models.mjs'",
      "note": "预设就是现成的配置对象"
    }
  ],
  "provides": [
    {
      "type": "tool-preset",
      "tool": "org.glow.tool.stochastic-process",
      "preset": "motor"
    },
    {
      "type": "module",
      "path": "plugins/simulation/process-models.mjs",
      "exports": [
        "uniporter",
        "trackMotor",
        "dynamicFilament",
        "reactionNetwork",
        "PROCESS_PRESETS"
      ]
    }
  ],
  "dependencies": [
    {
      "id": "org.glow.structure",
      "version": "1.0.0"
    }
  ],
  "permissions": [],
  "status": {
    "level": "real-data",
    "summary": "用现有随机过程引擎真跑，与解析解对照（单测）。",
    "limits": [
      "速率与势垒位置是教学用的数，不是某个真实马达的测量值",
      "最简的单头模型，没有双头协调",
      "位置只是计数，不知道轨道在哪里（没有与结构联动）",
      "引擎每次运行最多 25 万个事件"
    ]
  },
  "license": "Apache-2.0",
  "author": "Molecule Glow 官方",
  "docs": [
    "docs/history/routine/2026-11-21-process-models.md"
  ],
  "tags": [
    "过程",
    "随机"
  ]
}
