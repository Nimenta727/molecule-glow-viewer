{
  "format": "glow-plugin",
  "schemaVersion": 1,
  "id": "org.glow.plugin.filament",
  "version": "1.0.0",
  "name": "动态不稳定的丝",
  "summary": "一条丝在生长与缩短两种状态之间随机切换（突变与救援），记录长度的变化。",
  "category": "process",
  "adds": [
    "生长相 / 缩短相、突变率、救援率、游离亚基浓度",
    "突变率为 0 时是只生长的丝",
    "记录长度、生长相时间比例、突变与救援次数"
  ],
  "usage": [
    {
      "title": "把丝加进作品",
      "how": "在 Studio 的“工具”页签选“动态不稳定的丝”预设；调游离亚基浓度看长度"
    },
    {
      "title": "代码里取现成的配置",
      "how": "import { PROCESS_PRESETS } from 'plugins/simulation/process-models.mjs'",
      "note": "预设就是现成的配置对象"
    }
  ],
  "provides": [
    {
      "type": "tool-preset",
      "tool": "org.glow.tool.stochastic-process",
      "preset": "filament"
    },
    {
      "type": "module",
      "path": "plugins/simulation/process-models.mjs",
      "exports": [
        "uniporter",
        "trackMotor",
        "dynamicFilament",
        "reactionNetwork",
        "PROCESS_PRESETS"
      ]
    }
  ],
  "dependencies": [
    {
      "id": "org.glow.structure",
      "version": "1.0.0"
    }
  ],
  "permissions": [],
  "status": {
    "level": "real-data",
    "summary": "用现有随机过程引擎真跑，与解析解对照（单测）。",
    "limits": [
      "是**一条**丝，不是群体；也不是真实微管或肌动蛋白的参数",
      "速率是教学用的整数",
      "没有空间、没有 GTP 帽的结构",
      "引擎每次运行最多 25 万个事件"
    ]
  },
  "license": "Apache-2.0",
  "author": "Molecule Glow 官方",
  "docs": [
    "docs/history/routine/2026-11-21-process-models.md"
  ],
  "tags": [
    "过程",
    "随机"
  ]
}
